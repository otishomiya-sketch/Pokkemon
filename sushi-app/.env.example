# このファイルを .env.local にコピーして値を入れる（.env.local は GitHub に上がりません）
# 未設定のあいだはデモモード（固定の見本を表示）で動きます
ANTHROPIC_API_KEY=
# API キーがワークスペースに属していない場合だけ必要（Console の設定 → ワークスペースで確認、wrkspc_ で始まる）
ANTHROPIC_WORKSPACE_ID=
# あればメニューのイメージ画像を作れる（OpenAI の API キー）
OPENAI_API_KEY=

# ---- 有料化（Stripe）。すべて揃うまでは料金プランを出さず、無料デモだけで動く ----
STRIPE_SECRET_KEY=          # 本番は制限付きキー（rk_live_…）
STRIPE_PRICE_LIGHT=         # prod_… または price_…
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_TAX_RATE_ID=         # txr_…（消費税10%・税別 exclusive）
APP_URL=                    # 公開 URL（例: https://pokkemon-production.up.railway.app）
TERMS_URL=                  # 利用規約・特定商取引法に基づく表記のページ
CONTACT_TEXT=               # 例: お問い合わせ：info@example.com
ADMIN_PASSWORD=             # 管理画面（/admin）のパスワード。無ければ管理画面は開けない
